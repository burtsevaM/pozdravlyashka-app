generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum PersonStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EventStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContributionStatus {
  PENDING
  PAID
  CANCELLED
}

enum NotificationChannel {
  APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id              String             @id @default(uuid())
  name            String
  email           String             @unique
  passwordHash    String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdTeams    Team[]             @relation("TeamCreator")
  teamMembers     TeamMember[]
  organizedEvents CelebrationEvent[] @relation("EventOrganizer")
  deputyEvents    CelebrationEvent[] @relation("EventDeputy")
  giftIdeas       GiftIdea[]
  votes           Vote[]
  contributions   Contribution[]
  delegationsFrom Delegation[]       @relation("DelegationFrom")
  delegationsTo   Delegation[]       @relation("DelegationTo")
  notifications   Notification[]
  notificationSettings UserNotificationSettings?
}

model Team {
  id          String             @id @default(uuid())
  name        String
  createdById String
  createdAt   DateTime           @default(now())
  createdBy   User               @relation("TeamCreator", fields: [createdById], references: [id])
  members     TeamMember[]
  people      Person[]
  events      CelebrationEvent[]
  delegations Delegation[]
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Person {
  id          String             @id @default(uuid())
  teamId      String
  fullName    String
  email       String?
  birthDate   DateTime
  department  String?
  status      PersonStatus       @default(ACTIVE)
  preferences String?
  notes       String?
  createdAt   DateTime           @default(now())
  team        Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  giftHistory GiftHistory[]
  events      CelebrationEvent[]
}

model GiftHistory {
  id            String   @id @default(uuid())
  personId      String
  year          Int?
  occasion      String
  giftName      String
  amount        Decimal? @db.Decimal(10, 2)
  organizerName String?
  comment       String?
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model CelebrationEvent {
  id                 String         @id @default(uuid())
  teamId             String
  personId           String
  date               DateTime
  status             EventStatus    @default(PLANNED)
  organizerId        String?
  deputyId           String?
  budget             Decimal?       @db.Decimal(10, 2)
  selectedGiftIdeaId String?
  createdAt          DateTime       @default(now())
  team               Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  person             Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  organizer          User?          @relation("EventOrganizer", fields: [organizerId], references: [id])
  deputy             User?          @relation("EventDeputy", fields: [deputyId], references: [id])
  selectedGiftIdea   GiftIdea?      @relation("SelectedGiftIdea", fields: [selectedGiftIdeaId], references: [id], onDelete: SetNull)
  giftIdeas          GiftIdea[]
  votes              Vote[]
  contributions      Contribution[]
  delegations        Delegation[]
  notifications      Notification[]
}

model GiftIdea {
  id                String             @id @default(uuid())
  eventId           String
  title             String
  description       String?
  price             Decimal?           @db.Decimal(10, 2)
  link              String?
  proposedById      String?
  createdAt         DateTime           @default(now())
  event             CelebrationEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  proposedBy        User?              @relation(fields: [proposedById], references: [id])
  selectedForEvents CelebrationEvent[] @relation("SelectedGiftIdea")
  votes             Vote[]
}

model Vote {
  id        String           @id @default(uuid())
  eventId   String
  ideaId    String
  userId    String
  createdAt DateTime         @default(now())
  event     CelebrationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  idea      GiftIdea         @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([ideaId])
}

model Contribution {
  id        String             @id @default(uuid())
  eventId   String
  userId    String
  amount    Decimal            @db.Decimal(10, 2)
  status    ContributionStatus @default(PENDING)
  comment   String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  event     CelebrationEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Delegation {
  id         String            @id @default(uuid())
  teamId     String
  eventId    String?
  fromUserId String
  toUserId   String
  startDate  DateTime
  endDate    DateTime?
  reason     String?
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event      CelebrationEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromUser   User              @relation("DelegationFrom", fields: [fromUserId], references: [id])
  toUser     User              @relation("DelegationTo", fields: [toUserId], references: [id])

  @@index([teamId, eventId])
}

model Notification {
  id                 String              @id @default(uuid())
  userId             String
  eventId            String?
  type               String
  title              String?
  message            String
  channel            NotificationChannel @default(APP)
  status             NotificationStatus  @default(PENDING)
  reminderOffsetDays Int?
  readAt             DateTime?
  sentAt             DateTime?
  errorMessage       String?
  createdAt          DateTime            @default(now())
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  event              CelebrationEvent?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId, channel, type, reminderOffsetDays])
  @@index([userId, createdAt])
}

model UserNotificationSettings {
  id            String   @id @default(uuid())
  userId        String   @unique
  inAppEnabled  Boolean  @default(true)
  emailEnabled  Boolean  @default(true)
  remind14Days  Boolean  @default(true)
  remind7Days   Boolean  @default(true)
  remind3Days   Boolean  @default(true)
  remind1Day    Boolean  @default(true)
  remindOnDay   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

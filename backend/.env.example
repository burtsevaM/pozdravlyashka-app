DATABASE_URL="postgresql://pozdravlyashka:pozdravlyashka@localhost:5432/pozdravlyashka?schema=public"
API_PORT=3000
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=1d

EMAIL_MODE=dev
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Поздравляшка <no-reply@pozdravlyashka.local>"

# Real SMTP mode uses an app password, not the regular mailbox password.
#
# Mail.ru:
# EMAIL_MODE=smtp
# EMAIL_HOST=smtp.mail.ru
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=your-login@mail.ru
# EMAIL_PASSWORD=app-password
# EMAIL_FROM="Поздравляшка <your-login@mail.ru>"
#
# Yandex:
# EMAIL_MODE=smtp
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=your-login@yandex.ru
# EMAIL_PASSWORD=app-password
# EMAIL_FROM="Поздравляшка <your-login@yandex.ru>"
